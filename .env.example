# OpenRouter API Key (required for research + script generation)
# Get your free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-120b:free

# Video defaults
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
FPS=30

# Cloudflare Workers AI (optional, best-quality scene images)
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_IMAGE_MODEL=@cf/lykon/dreamshaper-8-lcm

# Public base URL of this server (used for OAuth redirects and links)
# Set to your deployment URL, e.g. https://ianews.example.com
PUBLIC_BASE_URL=http://localhost:8090

# Facebook publishing (optional)
FB_APP_ID=
FB_APP_SECRET=
# FB_REDIRECT_URI is derived from PUBLIC_BASE_URL unless overridden explicitly
#FB_REDIRECT_URI=

# YouTube publishing (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Job queue tuning (optional)
# Max concurrently running generation jobs (default 1 — heavy stages)
#IANEWS_QUEUE_CONCURRENCY=1
# Hard per-stage timeout in ms (default 900000 = 15 min)
#IANEWS_STAGE_TIMEOUT_MS=900000
