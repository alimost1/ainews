{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": false,
    "declaration": false,
    "removeComments": true,
    "jsx": "react-jsx",
    "noEmitOnError": true,
    "strict": false,
    "lib": ["ES2022", "DOM"]
  },
  "include": [
    "src/pipeline/**/*.ts",
    "src/types/**/*.ts"
  ],
  "exclude": ["src/components/**", "src/index.ts", "src/main.ts", "node_modules"]
}
